{
  "name": "modding-helper",
  "version": "1.1.0",
  "description": "osu!taiko modding support tool",
  "main": "electron/main.js",
  "repository": "https://github.com/calmeel/modding-helper",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "electron tests/electron-smoke.cjs",
    "prebuild:electron": "node -e \"require('electron')\"",
    "build:electron": "electron-builder --win nsis",
    "build": "npm run build:electron",
    "publish": "node -e \"require('electron')\" && electron-builder --win nsis --publish always"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.vanity8.modding-helper",
    "productName": "Modding Helper",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "images/icon.ico",
      "artifactName": "ModdingHelper-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "calmeel",
        "repo": "modding-helper"
      }
    ],
    "files": [
      "**/*",
      "!.git/**",
      "!node_modules/.cache/**",
      "!electron/dist/**",
      "!electron/dist-verify/**",
      "!tests/**",
      "!.claude/**",
      "!.vscode/**"
    ],
    "asarUnpack": [
      "electron/osu/osuMemory.ps1"
    ],
    "extraFiles": [],
    "directories": {
      "output": "electron/dist"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2"
  },
  "overrides": {
    "minimatch@>=7": "^11.0.4"
  },
  "engines": {
    "node": ">=24.22.2"
  }
}
